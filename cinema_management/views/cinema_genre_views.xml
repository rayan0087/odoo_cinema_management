<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cinema_genre_tree" model="ir.ui.view">
        <field name="name">cinema.genre.tree</field>
        <field name="model">cinema.genre</field>
        <field name="arch" type="xml">
            <list string="Movie Genres" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_cinema_genre" model="ir.actions.act_window">
        <field name="name">Movie Genres</field>
        <field name="res_model">cinema.genre</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
