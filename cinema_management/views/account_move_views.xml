<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_cinema_inherit" model="ir.ui.view">
        <field name="name">account.move.form.cinema.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Print Cinema Tickets Button in Invoice Header -->
            <xpath expr="//header" position="inside">
                <field name="ticket_count" invisible="1"/>
                <button name="action_print_cinema_tickets" 
                        string="Print Cinema Tickets" 
                        type="object" 
                        class="oe_highlight" 
                        invisible="ticket_count == 0"/>
            </xpath>

            <!-- Cinema Tickets Smart Button in Button Box -->
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_cinema_tickets" 
                        type="object" 
                        class="oe_stat_button" 
                        icon="fa-ticket" 
                        invisible="ticket_count == 0">
                    <field name="ticket_count" widget="statinfo" string="Cinema Tickets"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
