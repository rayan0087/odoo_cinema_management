<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_cinema_showtime_tree" model="ir.ui.view">
        <field name="name">cinema.showtime.tree</field>
        <field name="model">cinema.showtime</field>
        <field name="arch" type="xml">
            <list string="Showtimes" decoration-info="state == 'scheduled'" decoration-muted="state == 'finished'">
                <field name="name"/>
                <field name="movie_id"/>
                <field name="hall_id"/>
                <field name="start_time"/>
                <field name="end_time"/>
                <field name="booked_seats_count" string="Tickets Sold"/>
                <field name="price" widget="monetary"/>
                <field name="state" widget="badge" 
                       decoration-success="state == 'ongoing'" 
                       decoration-info="state == 'scheduled'" 
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_cinema_showtime_calendar" model="ir.ui.view">
        <field name="name">cinema.showtime.calendar</field>
        <field name="model">cinema.showtime</field>
        <field name="arch" type="xml">
            <calendar string="Showtime Calendar" 
                      date_start="start_time" 
                      date_stop="end_time" 
                      color="hall_id" 
                      mode="day">
                <field name="movie_id"/>
                <field name="hall_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_cinema_showtime_form" model="ir.ui.view">
        <field name="name">cinema.showtime.form</field>
        <field name="model">cinema.showtime</field>
        <field name="arch" type="xml">
            <form string="Showtime">
                <header>
                    <button name="action_open_booking_wizard" 
                            string="Book Ticket" 
                            type="object" 
                            class="oe_highlight" 
                            invisible="state not in ('scheduled', 'ongoing')"/>
                    <field name="state" widget="statusbar" statusbar_visible="scheduled,ongoing,finished,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                        <button name="action_view_tickets" 
                                type="object" 
                                class="oe_stat_button" 
                                icon="fa-ticket">
                            <field name="booked_seats_count" widget="statinfo" string="Tickets Sold"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Schedule Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Movie &amp; Studio">
                            <field name="movie_id" options="{'no_create_edit': True}"/>
                            <field name="hall_id" options="{'no_create_edit': True}"/>
                            <field name="price" widget="monetary"/>
                        </group>
                        <group string="Schedule &amp; Timing">
                            <field name="start_time"/>
                            <field name="cleaning_buffer"/>
                            <field name="end_time" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Sold Tickets">
                            <field name="ticket_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="seat_name"/>
                                    <field name="partner_id"/>
                                    <field name="price" widget="monetary"/>
                                    <field name="state" widget="badge" 
                                           decoration-success="state == 'valid'" 
                                           decoration-info="state == 'used'" 
                                           decoration-danger="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_cinema_showtime_search" model="ir.ui.view">
        <field name="name">cinema.showtime.search</field>
        <field name="model">cinema.showtime</field>
        <field name="arch" type="xml">
            <search string="Search Showtimes">
                <field name="movie_id"/>
                <field name="hall_id"/>
                <separator/>
                <filter name="filter_scheduled" string="Scheduled" domain="[('state', '=', 'scheduled')]"/>
                <filter name="filter_ongoing" string="Ongoing" domain="[('state', '=', 'ongoing')]"/>
                <filter name="filter_finished" string="Finished" domain="[('state', '=', 'finished')]"/>
                <group>
                    <filter name="group_by_movie" string="Movie" context="{'group_by': 'movie_id'}"/>
                    <filter name="group_by_hall" string="Studio" context="{'group_by': 'hall_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_start_time" string="Date" context="{'group_by': 'start_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_cinema_showtime" model="ir.actions.act_window">
        <field name="name">Showtimes</field>
        <field name="res_model">cinema.showtime</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_cinema_showtime_search"/>
        <field name="context">{'search_default_filter_scheduled': 1}</field>
    </record>
</odoo>
